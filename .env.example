# Please copy this file to .env and replace the passwords with secure values.
TZ=Asia/Taipei

# Docker image version. Read the official release notes and back up before upgrading.
MYSQL_IMAGE=mysql:8.4
PHPMYADMIN_IMAGE=phpmyadmin:5.2-apache

MYSQL_ROOT_PASSWORD=replace_with_a_strong_root_password
MYSQL_DATABASE=myapp
MYSQL_USER=myapp_user
MYSQL_PASSWORD=replace_with_a_strong_user_password
MYSQL_PORT=3306
PMA_PORT=8080
# Set this to the public phpMyAdmin URL when using a path-based reverse proxy.
# Example: http://172.16.5.73/phpmyadmin/
# deploy-nginx-path-proxy.bat updates .env automatically with the detected LAN IP.
PMA_ABSOLUTE_URI=http://localhost/phpmyadmin/
PMA_UPLOAD_LIMIT=128M
PMA_MEMORY_LIMIT=256M

# Optional extra backup destinations separated by semicolons.
# Relative paths are resolved from the project root.
# BACKUP_PATHS=D:\mysql-backups;\\server\share\mysql
BACKUP_PATHS=
